        <div class="ad-container">
            </div>
    </div>

    <script>
        // Initialize QR Code JS Instance
        let qrcode = new QRCode(document.getElementById("qrcode"), {
            width: 220,
            height: 220,
            correctLevel : QRCode.CorrectLevel.M
        });

        let currentFile = null;

        function switchTab(tab) {
            document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('active'));
            document.querySelectorAll('.tab-content').forEach(content => content.classList.remove('active'));

            if (tab === 'url') {
                document.querySelectorAll('.tab-btn')[0].classList.add('active');
                document.getElementById('url-tab').classList.add('active');
            } else {
                document.querySelectorAll('.tab-btn')[1].classList.add('active');
                document.getElementById('file-tab').classList.add('active');
            }
        }

        // Drag & drop logic
        const dropZone = document.getElementById('drop-zone');
        
        ['dragenter', 'dragover'].forEach(eventName => {
            dropZone.addEventListener(eventName, (e) => {
                e.preventDefault();
                dropZone.classList.add('dragover');
            }, false);
        });

        ['dragleave', 'drop'].forEach(eventName => {
            dropZone.addEventListener(eventName, (e) => {
                e.preventDefault();
                dropZone.classList.remove('dragover');
            }, false);
        });

        dropZone.addEventListener('drop', (e) => {
            const files = e.dataTransfer.files;
            if (files.length > 0) {
                document.getElementById('file-input').files = files;
                processFile(files[0]);
            }
        });

        function handleFileSelect(event) {
            const file = event.target.files[0];
            if (file) {
                processFile(file);
            }
        }

        function processFile(file) {
            currentFile = file;
            let sizeFormatted = (file.size / (1024 * 1024)).toFixed(2);
            let unit = "MB";
            if(file.size < 1024 * 1024) {
                sizeFormatted = (file.size / 1024).toFixed(1);
                unit = "KB";
            }
            document.getElementById('file-info').innerText = `📄 Ready: ${file.name} (${sizeFormatted} ${unit})`;
        }

        function generateURLQR() {
            let input = document.getElementById("url-input").value.trim();
            if (!input) {
                alert("Please enter a valid URL or text!");
                return;
            }
            
            if (!input.startsWith("http://") && !input.startsWith("https://") && input.includes(".")) {
                input = "https://" + input;
            }

            qrcode.clear();
            qrcode.makeCode(input);
            document.getElementById("download-btn").style.display = "block";
            document.getElementById("status-msg").innerText = "✅ QR Code generated for URL";
        }

        async function generateFileQR() {
            if (!currentFile) {
                alert("Please select or drop a file first!");
                return;
            }

            const btn = document.getElementById("file-btn");
            const status = document.getElementById("status-msg");
            
            btn.disabled = true;
            btn.innerText = "⏳ Uploading & Processing File...";
            status.innerText = "Creating cloud download link for your file...";

            try {
                // Upload file to reliable temporary CDN (tmpfiles.org)
                let formData = new FormData();
                formData.append("file", currentFile);

                let response = await fetch("https://tmpfiles.org/api/v1/upload", {
                    method: "POST",
                    body: formData
                });

                let result = await response.json();

                if (result.status === "success") {
                    // Convert URL format to direct link for mobile download
                    let fileUrl = result.data.url.replace("tmpfiles.org/", "tmpfiles.org/dl/");
                    
                    qrcode.clear();
                    qrcode.makeCode(fileUrl);
                    
                    document.getElementById("download-btn").style.display = "block";
                    status.innerText = "✅ 100% Scannable File QR Generated!";
                } else {
                    throw new Error("Upload failed");
                }
            } catch (err) {
                alert("Error generating file QR Code. Please check internet connection or try again.");
                status.innerText = "❌ Upload failed. Try a smaller file or try again.";
            } finally {
                btn.disabled = false;
                btn.innerText = "Generate File QR Code";
            }
        }

        function downloadQR() {
            let img = document.querySelector("#qrcode img");
            if (img && img.src) {
                let link = document.createElement("a");
                link.href = img.src;
                link.download = "qr-code.png";
                link.click();
            } else {
                let canvas = document.querySelector("#qrcode canvas");
                if (canvas) {
                    let link = document.createElement("a");
                    link.href = canvas.toDataURL("image/png");
                    link.download = "qr-code.png";
                    link.click();
                }
            }
        }
    </script>

</body>
</html>
